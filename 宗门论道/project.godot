;
; 《宗门论道》Godot项目配置
; 引擎版本: Godot 4.x (建议4.6+)
;
[application]

config/name="宗门论道"
config/description="修仙宗门大战 - 实时策略卡牌"
run/main_scene="res://scripts/scenes/Main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/core/EventBus.gd"
InputManager="*res://scripts/core/InputManager.gd"
SceneManager="*res://scripts/core/SceneManager.gd"
PlatformAdapter="*res://scripts/platform/PlatformAdapter.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input]

tap={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_index":1,"canceled":false,"pressed":true,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_mask":0)]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
